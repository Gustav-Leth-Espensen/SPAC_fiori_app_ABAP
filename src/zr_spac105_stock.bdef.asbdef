managed implementation in class zbp_r_spac105_stock unique;
strict ( 2 );
with draft;

define behavior for ZR_SPAC105_STOCK alias STOCK
persistent table zspac105_stock
draft table zspac105_stock_d
lock master
total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangeAT
{
  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;

  create;
  update;
  delete;

  field (readonly)
  Price,
  ProductName,
  WarehouseName,
  CityName,
  Description,
  Postnummer;

  field (mandatory:create)
  WarehouseId,
  ProductId,
  Amount;

  validation validateWarehouseId on save { create; field warehouseID; }
  validation validateProductID on save { create; field productID; }
  validation validatePositiveAmount on save { create; field Amount; }

   draft determine action Prepare
   {
   validation validateWarehouseId;
   validation validateProductID;
   validation validatePositiveAmount;
   }


  mapping for ZSPAC105_STOCK corresponding
  {
  warehouseId = warehouse_Id;
  productId = Product_Id;
  Amount = amount;


  LocalLastChangeAT = locallastchangeat;
  LastChangedAt = lastchangedat;
  LocalCreatedBy = localcreatedby;
  LocalCreatedAt = localcreatedat;
  LocalLastChangeBy = locallastchangeby;
  }

}