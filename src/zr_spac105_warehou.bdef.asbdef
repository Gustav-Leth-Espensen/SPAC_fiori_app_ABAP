managed implementation in class zbp_r_spac105_warehou unique;
strict ( 2 );
with draft;

define behavior for ZR_SPAC105_WAREHOU alias NEW_WAREHOUSE
persistent table zspac105_warehou
draft table zspac105_wareh_d
lock master
total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangeAT

{
  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  create;
  update;
  delete;


  field (readonly : update )
  WarehouseId,
  CityName,
  Postnummer,
  Adresse;

  field (readonly)
  Amount;

  field (mandatory : update)
  WarehouseName;


  mapping for ZSPAC105_WAREHOU corresponding
  {
  WarehouseId = warehouse_id;
  CityName = city_name;
  Adresse = adresse;
  WarehouseName = warehouse_name;

  LocalLastChangeAT = locallastchangeat;
  LastChangedAt = lastchangedat;
  LocalCreatedBy = localcreatedby;
  LocalCreatedAt = localcreatedat;
  LocalLastChangeBy = locallastchangeby;
  }



}