persistent table zspac105_new_war
draft table zspac105_war_d
lock master
total etag LastChangedAt

authorization master ( instance )
etag master LocalLastChangeAT
early numbering
{
  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  create ( authorization : global );
  update;
  delete;
  field ( readonly ) ProductId;
  field ( mandatory : create ) WarehouseId;
  field ( mandatory : create ) Amount;
  field ( readonly : update ) Price;
  field ( readonly : update ) productName;
  field ( readonly : update ) Description;



  mapping for ZSPAC105_NEW_WAR
  {
